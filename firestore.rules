rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER SECURITY FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based verification via Custom Claims OR Firestore Users collection
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isVendor() {
      return isAuthenticated() && (
        request.auth.token.role == 'vendor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor' ||
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data != null
      );
    }

    function isCustomer() {
      return isAuthenticated() && (
        request.auth.token.role == 'customer' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
      );
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // users/{userId}
    // uid, role ('vendor' | 'customer' | 'admin'), name, email, phone, status ('active' | 'blocked' | 'pending')
    // Vendor fields: businessName, category, operatingAreas, profileImageUrl, vehicleDetails
    // Customer fields: primaryLocation, preferredCategories, preferredAreas, fcmToken
    // =========================================================================
    match /users/{userId} {
      // Public can read vendor profiles, authenticated users can read profiles
      allow read: if true;
      
      // User can create/edit their own document, or Admin can manage all
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          // Normal users cannot elevate their own role or self-unblock
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']) || isAdmin())
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. PRODUCTS COLLECTION (or users/{vendorId}/products subcollection)
    // productId, vendorId, name, category, price, unit, availableQuantity, isAvailable, imageUrl
    // =========================================================================
    match /products/{productId} {
      // Public can read active catalog items
      allow read: if true;

      // Only the vendor who owns the product or an Admin can create it
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isVendor() && (
          request.resource.data.vendor_id == request.auth.uid ||
          request.resource.data.vendorId == request.auth.uid
        ))
      );

      // Only vendor owner or Admin can update or delete product
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.vendor_id == request.auth.uid || resource.data.vendorId == request.auth.uid)
      );
    }

    // Support subcollection catalog: users/{vendorId}/products/{productId}
    match /users/{vendorId}/products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(vendorId) || isAdmin());
    }

    // =========================================================================
    // 3. SCHEDULES COLLECTION (Planned Visits & Route Telemetry)
    // scheduleId, vendorId, vendorName, vendorCategory, date, areaName, areaLocation,
    // expectedArrivalTime, expectedDepartureTime, availableProductIds, status, hasConflict, liveCoordinates
    // =========================================================================
    match /schedules/{scheduleId} {
      // Public can read planned visits
      allow read: if true;

      // Only authenticated vendor creating for themselves, or an Admin
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isVendor() &&
          request.resource.data.vendorId == request.auth.uid &&
          request.resource.data.status in ['scheduled', 'in_transit', 'nearby', 'arrived', 'completed', 'cancelled']
        )
      );

      // Only the vendor owner or Admin can advance visit status or update telemetry
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.vendorId == request.auth.uid &&
          request.resource.data.status in ['scheduled', 'in_transit', 'nearby', 'arrived', 'completed', 'cancelled']
        )
      );

      // Only the vendor owner or Admin can cancel/delete a schedule
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.vendorId == request.auth.uid
      );
    }

    // =========================================================================
    // 4. ORDERS COLLECTION
    // orderId, customerId, customerName, vendorId, scheduleId, items, totalAmount, status, orderDate, arrivalETA
    // Statuses: 'placed', 'accepted', 'preparing', 'on_the_way', 'nearby', 'arrived', 'completed', 'cancelled'
    // =========================================================================
    match /orders/{orderId} {
      // Visible to customer, vendor involved, or Admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );

      // Customer or Admin can place an order
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.customerId == request.auth.uid
      );

      // Both customer and vendor involved (or Admin) can update order state
      // (e.g. vendor advances delivery step; customer requests additional item)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. RATINGS COLLECTION
    // ratingId, orderId, vendorId, customerId, score (1-5), feedbackText, createdAt
    // =========================================================================
    match /ratings/{ratingId} {
      // Anyone authenticated can read ratings
      allow read: if true;

      // Customer who made the order can submit a 1-5 star review
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.customerId == request.auth.uid &&
          request.resource.data.score >= 1 && request.resource.data.score <= 5)
      );

      // Only author customer or Admin can edit or delete their rating
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid
      );
    }

    // Backward compatibility for reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // 6. CATEGORIES COLLECTION
    // categoryId, name, icon, isActive
    // =========================================================================
    match /categories/{categoryId} {
      // Anyone can read active product categories
      allow read: if true;

      // Only platform Admins can create, update, or remove categories
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. CONFLICTS LOG COLLECTION
    // =========================================================================
    match /conflicts/{conflictId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && isVendor());
    }

    // =========================================================================
    // 8. COMPLAINTS COLLECTION
    // complaintId, customerId, vendorId, orderId, description, status, createdAt
    // =========================================================================
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );

      allow create: if isAuthenticated();

      // Only Admin can update status (investigating / resolved)
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. VENDORS & CHATS COLLECTION
    // =========================================================================
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isOwner(vendorId) || isAdmin();

      match /chats/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
