# ==============================================================================
# VendorSaathi / CustomerVendor - Environment Variables Configuration Template
# ==============================================================================
# Note: Copy this file to '.env' or '.env.local' and provide actual credentials.
# In Vercel / Cloud Deployments, configure these under Project Settings > Environment Variables.

# ------------------------------------------------------------------------------
# 1. Backend REST & WebSocket API Base URL
# ------------------------------------------------------------------------------
# Development: http://localhost:5000
# Production:  https://api.vendorsaathi.com
VITE_API_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Infrastructure & Authentication (Google OAuth)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 3. Stripe Payment Gateway (Card Payments & 3DS Authentication)
# ------------------------------------------------------------------------------
# Test mode keys start with: pk_test_... (Publishable Key)
# Live mode keys start with: pk_live_... (Publishable Key)
# NOTE: Never put secret keys (sk_test_... or sk_live_...) in client environment files.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ------------------------------------------------------------------------------
# 4. NPCI Bharat UPI Instant Payment Gateway (Dynamic QR & Direct Intent)
# ------------------------------------------------------------------------------
# Valid Virtual Payment Address (VPA) registered with banking partner (e.g. HDFC / ICICI)
VITE_UPI_MERCHANT_VPA=yourbusiness@okhdfcbank
VITE_UPI_MERCHANT_NAME=VendorSaathi Store
